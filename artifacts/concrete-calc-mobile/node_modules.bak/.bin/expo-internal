#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/workspace/node_modules/.pnpm/@expo+cli@54.0.23_expo-router@6.0.24_expo@54.0.36_graphql@16.8.1_react-native@0.81.5_@b_1abfdb78905024444fce3959da1b5364/node_modules/@expo/cli/node_modules:/workspace/node_modules/.pnpm/@expo+cli@54.0.23_expo-router@6.0.24_expo@54.0.36_graphql@16.8.1_react-native@0.81.5_@b_1abfdb78905024444fce3959da1b5364/node_modules:/workspace/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/workspace/node_modules/.pnpm/@expo+cli@54.0.23_expo-router@6.0.24_expo@54.0.36_graphql@16.8.1_react-native@0.81.5_@b_1abfdb78905024444fce3959da1b5364/node_modules/@expo/cli/node_modules:/workspace/node_modules/.pnpm/@expo+cli@54.0.23_expo-router@6.0.24_expo@54.0.36_graphql@16.8.1_react-native@0.81.5_@b_1abfdb78905024444fce3959da1b5364/node_modules:/workspace/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../@expo/cli/build/bin/cli" "$@"
else
  exec node  "$basedir/../@expo/cli/build/bin/cli" "$@"
fi
