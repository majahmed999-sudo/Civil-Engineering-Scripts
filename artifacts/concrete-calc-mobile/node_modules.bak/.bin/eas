#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/workspace/node_modules/.pnpm/eas-cli@21.0.2_@types+node@25.6.2_typescript@5.9.3/node_modules/eas-cli/node_modules:/workspace/node_modules/.pnpm/eas-cli@21.0.2_@types+node@25.6.2_typescript@5.9.3/node_modules:/workspace/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/workspace/node_modules/.pnpm/eas-cli@21.0.2_@types+node@25.6.2_typescript@5.9.3/node_modules/eas-cli/node_modules:/workspace/node_modules/.pnpm/eas-cli@21.0.2_@types+node@25.6.2_typescript@5.9.3/node_modules:/workspace/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../eas-cli/bin/run" "$@"
else
  exec node  "$basedir/../eas-cli/bin/run" "$@"
fi
